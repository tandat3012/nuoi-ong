NODE_ENV=
DATABASE_URL=

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=
WEB_ORIGIN=

#CLOUDINARY
CLOUDINARY_NAME=
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_URL=
#PUSH (Expo)
# Enable only after removing fake Swagger device registrations.
PUSH_WORKER_ENABLED=
# Optional: required if enhanced push security is enabled in EAS.
EXPO_ACCESS_TOKEN=
# Expo recommends checking receipts after 15 minutes; 60000 is useful for local tests.
PUSH_RECEIPT_DELAY_MS=900000
#PAYMENTS (VietQR + SePay)
# Receiving account shown in the order QR; bank transfer checkout is off until all four are set.
# STORE_BANK_BIN is the 6-digit NAPAS BIN, e.g. 970436 = Vietcombank, 970422 = MB.
STORE_BANK_BIN=
STORE_BANK_NAME=
STORE_BANK_ACCOUNT_NUMBER=
STORE_BANK_ACCOUNT_NAME=
# Key set in SePay → Webhooks → "API Key"; the webhook rejects every call while empty.
SEPAY_WEBHOOK_API_KEY=
# Lets store staff post fake bank transfers for demos; never enable in production.
PAYMENT_SIMULATOR_ENABLED=false
