# Required by Docker Compose for the local PostgreSQL container.
POSTGRES_PASSWORD=change-me
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# Optional Cloudinary cloud name, passed to the frontend build.
CLOUDINARY_CLOUD_NAME=
# Expo push worker for the mobile app; off by default (see api/.env.example).
PUSH_WORKER_ENABLED=false
EXPO_ACCESS_TOKEN=
PUSH_RECEIPT_DELAY_MS=900000
# VietQR + SePay payments for the store (see api/.env.example).
STORE_BANK_BIN=
STORE_BANK_NAME=
STORE_BANK_ACCOUNT_NUMBER=
STORE_BANK_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
PAYMENT_SIMULATOR_ENABLED=false
